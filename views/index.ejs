<%- include('partials/header.ejs'); -%>



  <!-- Navigation -->
  <nav class="navbar navbar-expand-lg navbar-dark portfolio-navbar sticky-top">
    <div class="container">

      <a class="navbar-brand fw-bold" href="#home">
        Kate | QA Automation Portfolio
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">

        <ul class="navbar-nav ms-auto">

          <li class="nav-item">
            <a id="nav-home" class="nav-link" href="#home">Home</a>
          </li>

          <li class="nav-item">
            <a id="nav-about" class="nav-link" href="#about">About</a>
          </li>

          <li class="nav-item">
            <a id="nav-skills" class="nav-link" href="#skills">Skills</a>
          </li>

          <li class="nav-item">
            <a id="nav-project" class="nav-link" href="#project">QA Project</a>
          </li>

          <li class="nav-item">
            <a id="nav-contact" class="nav-link" href="#contact">Contact</a>
          </li>

        </ul>

      </div>

    </div>
  </nav>


  <!-- Hero -->
  <section id="home" class="hero-section">

    <div class="container py-5">

      <div class="row align-items-center g-5 min-vh-75">

        <!-- Text -->
        <div class="col-lg-6">

          <p class="hero-label mb-2">
            Hi, I'm Kate
          </p>

          <h1 class="display-4 fw-bold mb-3">
            Software Tester | SDET
          </h1>

          <h2 class="h4 mb-4 hero-subtitle">
            ISTQB-Certified QA Professional
          </h2>

          <p class="lead mb-2">
            Manual & Automated Testing
          </p>

          <p class="hero-testing-types mb-4">
            UI • API • Performance • Integration Testing
          </p>

          <div class="d-flex flex-wrap gap-3">

            <a
              id="skills-button"
              href="#skills"
              class="btn btn-primary btn-lg px-4"
            >
              View My Skills
            </a>

            <a
              id="project-button"
              href="#project"
              class="btn btn-primary btn-lg px-4"
            >
              View QA Project
            </a>

          </div>

        </div>


        <!-- Image -->
        <div class="col-lg-6 text-center">

          <img
            id="hero-image"
            src="/assets/images/ImageLaptop.png"
            class="img-fluid hero-img"
            alt="QA automation testing workspace with laptop"
          >

        </div>

      </div>

    </div>

  </section>


  <!-- About -->
  <section id="about" class="section-padding">

    <div class="container">

      <div class="row justify-content-center">

        <div class="col-lg-9 text-center">

          <p class="section-label">ABOUT ME</p>

          <h2 class="section-title mb-4">
            Quality-Focused Software Tester
          </h2>

          <p class="about-text">
            I am an ISTQB-certified Software Tester with experience
            in manual and automated testing of complex software systems.
          </p>

          <p class="about-text">
            My experience includes UI, API, integration, regression,
            performance, and hardware-software integration testing.
          </p>

          <p class="about-text">
            I build automated tests and use CI/CD practices to improve
            software quality, regression coverage, and release confidence.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- Skills -->
  <section id="skills" class="skills-section section-padding">

    <div class="container">

      <div class="text-center mb-5">

        <p class="section-label">SKILLS</p>

        <h2 class="section-title">
          Testing & Automation Skills
        </h2>

      </div>


      <div class="row g-4">

        <div class="col-md-6 col-lg-4">
          <div id="skill-software-testing" class="skill-card">
            <h3>Software Testing</h3>
            <p>
              Functional, regression, exploratory,
              integration, and system testing.
            </p>
          </div>
        </div>


        <div class="col-md-6 col-lg-4">
          <div id="skill-automation" class="skill-card">
            <h3>Automation Testing</h3>
            <p>
              Selenium WebDriver, NUnit, Ranorex,
              Playwright, and test framework development.
            </p>
          </div>
        </div>


        <div class="col-md-6 col-lg-4">
          <div id="skill-api" class="skill-card">
            <h3>API Testing</h3>
            <p>
              REST API validation using Postman
              and automated API testing techniques.
            </p>
          </div>
        </div>


        <div class="col-md-6 col-lg-4">
          <div id="skill-performance" class="skill-card">
            <h3>Performance Testing</h3>
            <p>
              Load, stress, endurance, and performance
              testing using JMeter.
            </p>
          </div>
        </div>


        <div class="col-md-6 col-lg-4">
          <div id="skill-cicd" class="skill-card">
            <h3>CI/CD</h3>
            <p>
              Automated test execution and integration
              with Azure DevOps pipelines.
            </p>
          </div>
        </div>


        <div class="col-md-6 col-lg-4">
          <div id="skill-database" class="skill-card">
            <h3>Database Testing</h3>
            <p>
              SQL validation with SQLite and MySQL
              for backend and data verification.
            </p>
          </div>
        </div>

      </div>

    </div>

  </section>


  <!-- QA Project -->
  <section id="project" class="project-section section-padding">

    <div class="container">

      <div class="row align-items-center g-5">

        <div class="col-lg-7">

          <p class="section-label text-info">
            QA PROJECT
          </p>

          <h2 class="display-6 fw-bold mb-4">
            QA Automation Portfolio Project
          </h2>

          <p class="lead">
            This website is also used as an application under test.
          </p>

          <p class="project-description">
            The project demonstrates manual and automated testing
            of a responsive web application using industry-standard
            testing tools and practices.
          </p>


          <div class="row g-3 mt-4">

            <div class="col-sm-6">
              <div class="technology-item">
                Selenium WebDriver
              </div>
            </div>

            <div class="col-sm-6">
              <div class="technology-item">
                Java
              </div>
            </div>

            <div class="col-sm-6">
              <div class="technology-item">
                Playwright
              </div>
            </div>

            <div class="col-sm-6">
              <div class="technology-item">
                JavaScript
              </div>
            </div>

            <div class="col-sm-6">
              <div class="technology-item">
                Maven
              </div>
            </div>

            <div class="col-sm-6">
              <div class="technology-item">
                Git / GitHub
              </div>
            </div>

          </div>


          <div class="d-flex flex-wrap gap-3 mt-5">

            <a
              id="test-cases-button"
              href="#"
              class="btn btn-info btn-lg"
            >
              View Test Cases
            </a>

            <a
              id="automation-button"
              href="#"
              class="btn btn-outline-light btn-lg"
            >
              View Automation
            </a>

          </div>

        </div>


        <div class="col-lg-5">

          <div class="project-summary-card">

            <h3 class="mb-4">
              Project Coverage
            </h3>

            <ul class="project-list">

              <li>UI Testing</li>

              <li>Navigation Testing</li>

              <li>Responsive Testing</li>

              <li>Cross-Browser Testing</li>

              <li>Positive & Negative Testing</li>

              <li>Automated Regression Testing</li>

            </ul>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- Contact -->
<section id="contact" class="section-padding">

  <div class="container">

    <div class="row justify-content-center">

      <div class="col-lg-7">

        <div class="text-center mb-4">
          <p class="section-label">CONTACT</p>

          <h2 class="section-title mb-3">
            Let's Connect
          </h2>

          <p class="contact-text">
            Send me a message using the form below.
          </p>
        </div>


          <div id="success-message" class="alert alert-success d-none" role="alert">
            Message sent successfully!
          </div>

        <form id="contact-form" action="/contact" method="post">

          <div class="mb-3">
            <label for="name" class="form-label">
              Name
            </label>

            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              required
            >
          </div>


          <div class="mb-3">
            <label for="email" class="form-label">
              Email
            </label>

            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              required
            >
          </div>


          <div class="mb-3">
            <label for="message" class="form-label">
              Message
            </label>

            <textarea
              class="form-control"
              id="message"
              name="message"
              rows="5"
              required
            ></textarea>
          </div>


          <div class="text-center">
            <button
              id="send-message-button"
              type="submit"
              class="btn btn-primary btn-lg"
            >
              Send Message
            </button>
          </div>

        </form>

      </div>

    </div>

  </div>

</section>



<%- include('partials/footer.ejs'); -%>