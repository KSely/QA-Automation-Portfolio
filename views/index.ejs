<%- include('partials/header.ejs'); -%>

<!-- ==================== HERO SECTION ==================== -->
<!-- Main introduction with portfolio title, navigation buttons, and image (Hero Section) -->
<section id="home" class="hero-section">
  <div class="container py-5">
    <div class="row align-items-center g-5 min-vh-75">

      <!-- Main introduction and navigation buttons (Hero Content) -->
      <div class="col-lg-6">
        <p class="hero-label mb-2">Hi, I'm Kate</p>

        <h1 class="display-4 fw-bold mb-3">Software Tester | SDET</h1>

        <h2 class="h4 mb-4 hero-subtitle">ISTQB-Certified QA Professional</h2>

        <p class="lead mb-2">Manual & Automated Testing</p>

        <p class="hero-testing-types mb-4">
          Unit • UI • API • Performance • Integration Testing
        </p>

        <div class="d-flex flex-wrap gap-3">
          <a
            id="skills-button"
            href="#skills"
            class="btn btn-primary btn-lg px-4"
          >
            View My Skills
          </a>

          <a
            id="project-button"
            href="#project"
            class="btn btn-primary btn-lg px-4"
          >
            View QA Project
          </a>
        </div>
      </div>

      <!-- Main portfolio image (Hero Image) -->
      <div class="col-lg-6 text-center">
        <img
          id="hero-image"
          src="/assets/images/ImageLaptop.png"
          class="img-fluid hero-img"
          alt="QA automation testing workspace with laptop"
        />
      </div>
    </div>
  </div>
</section>


<!-- ==================== ABOUT SECTION ==================== -->
<!-- Short overview of QA experience and professional background (About Section) -->
<section id="about" class="section-padding">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9 text-center">
        <p class="section-label">ABOUT ME</p>

        <h2 class="section-title mb-4">Quality-Focused Software Tester</h2>

        <p class="about-text">
          I am an ISTQB-certified Software Tester with experience in manual and
          automated testing of complex software systems.
        </p>

        <p class="about-text">
          My experience includes UI, API, integration, regression, performance,
          and hardware-software integration testing.
        </p>

        <p class="about-text">
          I build automated tests and use CI practices to improve software
          quality, regression coverage, and release confidence.
        </p>
      </div>
    </div>
  </div>
</section>


<!-- ==================== SKILLS SECTION ==================== -->
<!-- QA tools, technologies, and testing experience (Skills Section) -->
<section id="skills" class="skills-section section-padding">
