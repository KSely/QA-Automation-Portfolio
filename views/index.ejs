    <div class="text-center mb-5">
      <p class="section-label">PROFESSIONAL SKILLS</p>

      <h2 class="section-title">QA, Automation & Technical Skills</h2>
    </div>

    <!-- Main technical skill categories (Skill Cards) -->
    <div class="row g-4">
