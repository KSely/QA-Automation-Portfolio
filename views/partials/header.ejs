<!DOCTYPE html>
<html lang="en">

<head>
  <!-- ==================== PAGE SETTINGS ==================== -->
  <!-- Defines page encoding, responsive behavior, and browser tab title (Document Metadata) -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Kate | QA Automation Portfolio</title>

  <!-- Loads Bootstrap styles for layout and responsive design (CSS Framework) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Loads custom styles for the portfolio website (Custom Stylesheet) -->
  <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

  <!-- ==================== NAVIGATION BAR ==================== -->
  <!-- Provides responsive navigation between pages and page sections (Navigation Bar) -->
  <nav class="navbar navbar-expand-lg portfolio-navbar sticky-top">
  <div class="container">

    <!-- Returns to the main portfolio page (Brand Link) -->
    <a class="navbar-brand fw-bold" href="/">
      Kate | QA Automation Portfolio
    </a>

    <!-- Opens and closes the navigation menu on smaller screens (Mobile Navigation Toggle) -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#portfolioNavbar"
      aria-controls="portfolioNavbar"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Displays different navigation links depending on the current page (Conditional Navigation) -->
    <div class="collapse navbar-collapse" id="portfolioNavbar">
      <div class="navbar-nav ms-auto">

        <!-- Navigation links for the project details page (Project Navigation) -->
        <% if (page === "project") { %>

          <a class="nav-link" href="#overview">Overview</a>
          <a class="nav-link" href="#architecture">Architecture</a>
          <a class="nav-link" href="#tech-stack">Tech Stack</a>
          <a class="nav-link" href="#qa-stack">QA Stack</a>
          <a class="nav-link" href="#test-strategy">Test Strategy</a>
          <a class="nav-link" href="#api-testing">API</a>
          <a class="nav-link" href="#database-testing">Database</a>
          <a class="nav-link" href="/project/automation">Automation</a>

        <!-- Navigation links for the automation details page (Automation Navigation) -->
        <% } else if (page === "automation") { %>

          <a class="nav-link" href="/project">Project Overview</a>
          <a class="nav-link" href="#ui-automation">UI Automation</a>
          <a class="nav-link" href="#api-automation">API Testing</a>
          <a class="nav-link" href="#performance-testing">Performance</a>
          <a class="nav-link" href="#test-results">Test Results</a>

        <!-- Default navigation links for the main portfolio page (Home Navigation) -->
        <% } else { %>

          <a class="nav-link" href="#home">Home</a>
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#skills">Skills</a>
          <a class="nav-link" href="#project">QA Project</a>
          <a class="nav-link" href="#contact">Contact</a>

        <% } %>

      </div>
    </div>
  </div>
</nav>