<%- include('partials/header.ejs'); -%>

<section class="section-padding">
  <div class="container text-center">

    <p class="section-label">TEST AUTOMATION</p>

    <h1 class="section-title">
      Automation & Test Artifacts
    </h1>

    <p class="about-text mt-3">
      UI automation, API testing, performance testing,
      and test results for the Full-Stack QA Automation Project.
    </p>

  </div>
</section>
<!-- UI Automation -->
<section id="ui-automation" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">UI AUTOMATION</p>

      <h2 class="section-title">
        Selenium & Playwright Automation
      </h2>

      <p class="about-text mt-3">
        Automated UI testing is implemented using Selenium WebDriver
        and Playwright to validate key user workflows and browser behavior.
      </p>
    </div>

    <div class="row g-4">

      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">SELENIUM WEBDRIVER</span>

          <h3>Java · TestNG · Maven</h3>

          <p>
            Selenium automation is used for browser-based functional
            and regression testing of the application.
          </p>

        </div>
      </div>

      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">PLAYWRIGHT</span>

          <h3>JavaScript</h3>

          <p>
            Playwright is used for modern end-to-end UI automation
            and cross-browser validation.
          </p>

        </div>
      </div>

    </div>

  </div>
</section>
<!-- API Testing -->
<section id="api-automation" class="section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">API TESTING</p>

      <h2 class="section-title">
        Postman API Validation
      </h2>

      <p class="about-text mt-3">
        API testing validates application endpoints, HTTP responses,
        input validation, error handling, and backend behavior.
      </p>
    </div>

    <div class="row g-4">

      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method get-method">GET</span>

          <h3>/api/status</h3>

          <p>
            Validates backend availability and the API status response.
          </p>

          <ul>
            <li>HTTP status code validation</li>
            <li>JSON response validation</li>
            <li>Response content verification</li>
          </ul>

        </div>
      </div>

      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method post-method">POST</span>

          <h3>/contact</h3>

          <p>
            Validates contact form requests, server-side validation,
            and database persistence.
          </p>

          <ul>
            <li>Valid request testing</li>
            <li>Missing field validation</li>
            <li>Invalid email validation</li>
            <li>Response body validation</li>
            <li>Database record verification</li>
          </ul>

        </div>
      </div>

    </div>

  </div>
</section>
<!-- Performance Testing -->
<section id="performance-testing" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">PERFORMANCE TESTING</p>

      <h2 class="section-title">
        Apache JMeter
      </h2>

      <p class="about-text mt-3">
        Performance testing evaluates application response times,
        stability, and behavior under different workload conditions.
      </p>
    </div>

    <div class="row g-4">

      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">LOAD TESTING</span>

          <h3>Expected Workload</h3>

          <p>
            Measures application response times and behavior
            under expected concurrent user load.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">STRESS TESTING</span>

          <h3>High Workload</h3>

          <p>
            Evaluates application stability and behavior
            when workload exceeds normal operating conditions.
          </p>
        </div>
      </div>

      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">ENDURANCE TESTING</span>

          <h3>Extended Duration</h3>

          <p>
            Verifies application stability and response behavior
            during sustained workload over time.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
<!-- Test Results -->
<section id="test-results" class="section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">TEST RESULTS</p>

      <h2 class="section-title">
        Test Reports & Evidence
      </h2>

      <p class="about-text mt-3">
        Test execution results and supporting artifacts provide evidence
        of automated test coverage and application quality.
      </p>
    </div>

    <div class="row g-4">

      <div class="col-md-6 col-lg-3">
        <div class="testing-stack-card">
          <span class="testing-category">SELENIUM</span>
          <h3>TestNG Reports</h3>
          <p>
            Automated UI test execution results and regression test reports.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="testing-stack-card">
          <span class="testing-category">PLAYWRIGHT</span>
          <h3>Playwright Reports</h3>
          <p>
            End-to-end test results with execution details and test evidence.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="testing-stack-card">
          <span class="testing-category">POSTMAN</span>
          <h3>API Results</h3>
          <p>
            API request validation results for application endpoints.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="testing-stack-card">
          <span class="testing-category">JMETER</span>
          <h3>Performance Results</h3>
          <p>
            Performance metrics and test results from workload execution.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<%- include('partials/footer.ejs'); -%>