<%- include('partials/header.ejs'); -%>

<!-- ==================== AUTOMATION OVERVIEW ==================== -->
<!-- Introduces the automation projects, testing areas, and test artifacts -->

<section class="section-padding">
  <div class="container">

    <div class="text-center">
      <p class="section-label">TEST AUTOMATION</p>

      <h1 class="section-title">
        Automation &amp; Test Artifacts
      </h1>

      <p class="about-text mt-3">
        Automated testing covers unit, UI, API, database, accessibility,
        performance, cross-browser, and continuous integration layers for the
        Full-Stack QA Automation Project.
      </p>
    </div>

    <div class="row g-4 justify-content-center mt-5">

      <!-- Contact validation unit tests -->
      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">JEST UNIT TESTING</span>

          <h3>Contact Validation</h3>

          <p>
            15 isolated tests validate required fields, whitespace handling,
            email-format validation, and validation error behavior.
          </p>

          <p class="mb-0">
            100% statement, branch, function, and line coverage for
            <strong>contactValidation.js</strong>.
          </p>

        </div>
      </div>

      <!-- Authentication validation unit tests -->
      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">JEST UNIT TESTING</span>

          <h3>Authentication Validation</h3>

          <p>
            13 isolated tests validate authentication input rules, including
            email normalization, registration validation, login validation,
            and password requirements.
          </p>

          <p class="mb-0">
            Contact and authentication validation together provide
            <strong>28 Jest unit tests</strong>.
          </p>

        </div>
      </div>

    </div>

  </div>
</section>


<!-- ==================== UI AUTOMATION ==================== -->
<!-- Shows the frameworks and coverage used for browser and accessibility automation -->

<section id="ui-automation" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">UI AUTOMATION</p>

      <h2 class="section-title">
        Selenium &amp; Playwright Automation
      </h2>

      <p class="about-text mt-3">
        Browser automation validates navigation, form behavior, authentication
        workflows, protected routes, regression scenarios, accessibility, and
        cross-browser application behavior.
      </p>
    </div>

    <div class="row g-4">

      <!-- Java-based Selenium automation framework -->
      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">SELENIUM WEBDRIVER</span>

          <h3>Java · TestNG · Maven</h3>

          <p>
            Selenium WebDriver provides browser-based functional and regression
            automation using Page Object Model structure and reusable page actions.
          </p>

          <ul class="mb-0">
            <li>Navigation and page-content validation</li>
            <li>Contact form workflows and negative scenarios</li>
            <li>Reusable Page Object Model structure</li>
            <li>Chrome · Firefox · Edge browser support</li>
            <li>TestNG execution and Allure reporting</li>
          </ul>

        </div>
      </div>

      <!-- JavaScript-based Playwright automation framework -->
      <div class="col-lg-6">
        <div class="testing-stack-card">

          <span class="testing-category">PLAYWRIGHT</span>

          <h3>JavaScript</h3>

          <p>
            Playwright provides end-to-end browser automation for application
            workflows, authentication behavior, regression testing, and
            cross-browser validation.
          </p>

          <ul class="mb-0">
            <li>Portfolio and contact-form workflows</li>
            <li>Registration, login, logout, and Account workflows</li>
            <li>Guest, user, and admin access validation</li>
            <li>Session persistence and protected-route behavior</li>
            <li>Chromium · Firefox · WebKit browser projects</li>
          </ul>

        </div>
      </div>

    </div>

    <!-- Accessibility automation implemented with Playwright and axe-core -->
    <div class="row justify-content-center mt-4">
      <div class="col-lg-10">

        <div id="accessibility-testing" class="testing-stack-card">

          <span class="testing-category">ACCESSIBILITY TESTING</span>

          <h3>Playwright + axe-core</h3>

          <div class="row g-4 mt-1">

            <div class="col-md-6">
              <p class="fw-semibold mb-2">Coverage</p>

              <ul class="mb-0">
                <li>Full-page WCAG-oriented automated scans</li>
                <li>Color-contrast validation</li>
                <li>Accessible names and required semantics</li>
                <li>Keyboard focus and Enter activation</li>
                <li>Authentication navigation focus-state validation</li>
                <li>Contact-form keyboard focus order</li>
              </ul>
            </div>

            <div class="col-md-6">
              <p class="fw-semibold mb-2">Defect Coverage</p>

              <ul class="mb-0">
                <li>DEF-003 — Home CTA color contrast</li>
                <li>DEF-004 — Architecture label color contrast</li>
                <li>DEF-005 — Authentication navigation contrast</li>
                <li>DEF-006 — Authentication link keyboard-focus contrast</li>
                <li>Accessibility regression coverage remains automated</li>
              </ul>
            </div>

          </div>

          <p class="mt-4 mb-2">
            <strong>Accessibility defect cycle:</strong>
            automated scans identified multiple real contrast defects in the
            application. The affected styles were corrected and retained in
            regression coverage, including keyboard-focus behavior for the
            authentication navigation link.
          </p>

          <p class="mb-0">
            Automated accessibility checks support regression testing but do not
            establish complete WCAG compliance or replace manual accessibility
            assessment.
          </p>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- ==================== API TESTING ==================== -->
<!-- Shows automated API coverage across application and authentication endpoints -->

<section id="api-automation" class="section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">API TESTING</p>

      <h2 class="section-title">
        API Test Automation &amp; Validation
      </h2>

      <p class="about-text mt-3">
        REST Assured · Playwright API · Ajv · JSON Schema Validator · Postman
      </p>

      <p class="about-text mt-3">
        API automation validates HTTP behavior, exact responses, validation
        errors, authentication state, authorization rules, API contracts,
        and related database state.
      </p>
    </div>

    <div class="row g-4">

      <!-- Application status endpoint -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method get-method">GET</span>

          <h3>/api/status</h3>

          <p>
            Validates backend availability and the expected application status
            response.
          </p>

          <ul>
            <li>200 OK response validation</li>
            <li>Exact status and message verification</li>
            <li>Required properties and data types</li>
            <li>JSON Schema validation</li>
          </ul>

        </div>
      </div>

      <!-- Contact endpoint -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method post-method">POST</span>

          <h3>/contact</h3>

          <p>
            Validates contact-form requests, server-side input handling,
            response behavior, and PostgreSQL persistence.
          </p>

          <ul>
            <li>Valid request: 200 OK</li>
            <li>Missing or invalid input: 400 Bad Request</li>
            <li>Exact success and error-message verification</li>
            <li>JSON Schema validation</li>
            <li>Database record verification</li>
          </ul>

        </div>
      </div>

      <!-- Registration and login -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method post-method">POST</span>

          <h3>Registration &amp; Login</h3>

          <p>
            Validates account creation, login behavior, credential handling,
            and authenticated session creation.
          </p>

          <ul>
            <li><strong>/api/auth/register</strong> — successful registration</li>
            <li>Email normalization and duplicate-email handling</li>
            <li>Default user role verification</li>
            <li>Client-supplied admin role is not accepted</li>
            <li><strong>/api/auth/login</strong> — successful existing-user login</li>
            <li>Wrong password and unknown email return the same generic 401 response</li>
          </ul>

        </div>
      </div>

      <!-- Session lifecycle -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method get-method">GET / POST</span>

          <h3>Session Lifecycle</h3>

          <p>
            Validates authenticated identity state and session invalidation
            through the server-managed authentication session.
          </p>

          <ul>
            <li><strong>GET /api/auth/me</strong> — authenticated user validation</li>
            <li>Unauthenticated request returns 401</li>
            <li><strong>POST /api/auth/logout</strong> — logout validation</li>
            <li>Authenticated session becomes invalid after logout</li>
            <li>Session behavior is exercised through the real session cookie</li>
          </ul>

        </div>
      </div>

      <!-- Admin authorization -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method get-method">GET</span>

          <h3>/api/auth/admin</h3>

          <p>
            Validates authentication and User / Admin role-based authorization
            for the protected Admin API.
          </p>

          <ul>
            <li>Guest request: 401 Unauthorized</li>
            <li>Authenticated user: 403 Forbidden</li>
            <li>Authenticated admin: 200 OK</li>
            <li>Backend RBAC enforcement</li>
          </ul>

        </div>
      </div>

      <!-- API automation approach -->
      <div class="col-lg-6">
        <div class="api-endpoint-card">

          <span class="api-method get-method">AUTOMATION</span>

          <h3>Validation Approach</h3>

          <p>
            API behavior is checked through automated HTTP requests with
            response, schema, authentication, and backend-state assertions.
          </p>

          <ul>
            <li>REST Assured automation in Java</li>
            <li>Playwright API automation in JavaScript</li>
            <li>Ajv and JSON Schema validation</li>
            <li>Positive and negative scenarios</li>
            <li>Database verification where applicable</li>
            <li>Parameterized SQL used for related database checks</li>
          </ul>

        </div>
      </div>

    </div>

  </div>
</section>


<!-- ==================== PERFORMANCE TESTING ==================== -->
<!-- Shows how application performance is tested under different workload conditions (Performance Testing) -->
<section id="performance-testing" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">PERFORMANCE TESTING</p>

      <h2 class="section-title">
        Apache JMeter
      </h2>

      <p class="about-text mt-3">
        Performance testing evaluates application response times,
        stability, and behavior under different workload conditions.
      </p>
    </div>

    <div class="row g-4">

      <!-- Establishes a controlled performance reference for later comparisons (Baseline Testing) -->
      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">BASELINE TESTING</span>

          <h3>Reference Performance</h3>

          <p>
            Establishes a stable performance reference using a controlled
            workload for comparison with higher-load test results.
          </p>
        </div>
      </div>

      <!-- Measures application behavior under an expected level of user activity (Load Testing) -->
      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">LOAD TESTING</span>

          <h3>Expected Workload</h3>

          <p>
            Measures application response times and behavior
            under expected concurrent user load.
          </p>
        </div>
      </div>

      <!-- Checks application behavior when the workload becomes much higher (Stress Testing) -->
      <div class="col-md-4">
        <div class="testing-stack-card">
          <span class="testing-category">STRESS TESTING</span>

          <h3>High Workload</h3>

          <p>
            Evaluates application stability and behavior
            when workload exceeds normal operating conditions.
          </p>
        </div>
      </div>

    </div>

  </div>
</section>


