<!-- ==================== API COVERAGE ==================== -->
<!-- Shows the application endpoints and the main checks performed against them (API Testing) -->

<section id="api-testing" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">API VALIDATION</p>

      <h2 class="section-title">API Coverage &amp; Endpoints</h2>

      <p class="about-text mt-3">
        Application APIs are validated for request handling, response content,
        status codes, validation errors, authentication state, authorization,
        database persistence, and API contract behavior.
      </p>
    </div>

    <div class="row g-4">

      <!-- Application health endpoint -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method get-method">GET</span>

          <h3>/api/status</h3>

          <p>
            Verifies that the application backend is available and returns the
            expected service status.
          </p>

          <ul>
            <li>Expected status: 200 OK</li>
            <li>Exact response validation</li>
            <li>Required properties and data types</li>
            <li>JSON Schema validation</li>
          </ul>
        </div>
      </div>

      <!-- Contact endpoint -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method post-method">POST</span>

          <h3>/contact</h3>

          <p>
            Processes validated contact form submissions and persists message
            data in PostgreSQL.
          </p>

          <ul>
            <li>Valid submission: 200 OK</li>
            <li>Missing or invalid input: 400 Bad Request</li>
            <li>Exact success and error messages</li>
            <li>JSON Schema validation</li>
            <li>Database persistence verification</li>
          </ul>
        </div>
      </div>

      <!-- Registration and login endpoints -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method post-method">POST</span>

          <h3>Registration &amp; Login</h3>

          <p>
            Validates account creation, credential handling, login behavior,
            and authenticated session creation.
          </p>

          <ul>
            <li><strong>/api/auth/register</strong> — successful registration: 201 Created</li>
            <li>Normalized duplicate email: 409 Conflict</li>
            <li>Client-supplied admin role is not accepted</li>
            <li><strong>/api/auth/login</strong> — successful login: 200 OK</li>
            <li>Invalid credentials return the same generic 401 response</li>
            <li>Password and password hash are not exposed in API responses</li>
          </ul>
        </div>
      </div>

      <!-- Session lifecycle endpoints -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method get-method">GET / POST</span>

          <h3>Session Lifecycle</h3>

          <p>
            Verifies authenticated identity state and confirms that logout
            invalidates the active server session.
          </p>

          <ul>
            <li><strong>GET /api/auth/me</strong> — authenticated user: 200 OK</li>
            <li>Unauthenticated request: 401 Unauthorized</li>
            <li><strong>POST /api/auth/logout</strong> — successful logout: 200 OK</li>
            <li>Session is invalid after logout</li>
            <li>Authenticated state is verified through the real session cookie</li>
          </ul>
        </div>
      </div>

      <!-- Role-protected endpoint -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
