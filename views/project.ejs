        <div class="testing-stack-card">
          <span class="testing-category">TEST DATA</span>
          <h3>Data-Driven Testing</h3>
          <p>Positive · Negative · Boundary Data</p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ==================== TEST STRATEGY & COVERAGE ==================== -->
