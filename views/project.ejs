<!-- ==================== APPLICATION ARCHITECTURE ==================== -->
<!-- Shows how the main parts of the application work together (Application Architecture) -->

<section id="architecture" class="skills-section section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">SYSTEM DESIGN</p>

      <h2 class="section-title">Application Architecture</h2>

      <p class="about-text mt-3">
        The application combines a server-rendered portfolio interface with a
        React authentication client, both connected to a shared Node.js / Express
        backend, session-based authentication, and PostgreSQL.
      </p>
    </div>

    <!-- Show how requests and data move through the application (Architecture Diagram) -->
    <div class="architecture-diagram">

      <!-- User accesses the application through a web browser -->
      <div class="architecture-node">
        <span class="architecture-label">CLIENT</span>
        <h3>User / Browser</h3>
        <p>Portfolio Pages · Authentication Pages</p>
      </div>

      <div class="architecture-connector">
        <span>HTTP / HTTPS · Session Cookie</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Two frontend areas are used within the same application -->
      <div class="architecture-application-layer">
        <span class="architecture-label">FRONTEND LAYER</span>

        <div class="architecture-layer-content">

          <div>
            <h3>Portfolio Frontend</h3>
            <p>EJS · Bootstrap · HTML · CSS · JavaScript</p>
          </div>

          <div>
            <h3>Authentication Frontend</h3>
            <p>React · Login · Register · Account · Admin</p>
          </div>

        </div>
      </div>

      <div class="architecture-connector">
        <span>Page Requests · Fetch API</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Shared backend application server -->
      <div class="architecture-node">
        <span class="architecture-label">APPLICATION SERVER</span>
        <h3>Node.js / Express.js</h3>
        <p>Portfolio · APIs · Authentication · Sessions</p>
      </div>

      <div class="architecture-connector">
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Backend application and security responsibilities -->
      <div class="architecture-application-layer">
        <span class="architecture-label">APPLICATION &amp; SECURITY LAYER</span>

        <div class="architecture-layer-content">

          <div>
            <h3>Routing &amp; APIs</h3>
            <p>Page Routes · Contact API · Authentication API</p>
          </div>

          <div>
            <h3>Request Processing</h3>
            <p>Validation · Processing · Response Handling</p>
          </div>

          <div>
            <h3>Authentication &amp; Sessions</h3>
            <p>express-session · connect-pg-simple · Session Cookie</p>
          </div>

          <div>
            <h3>Authorization &amp; Security</h3>
            <p>User / Admin RBAC · bcrypt Password Hashing</p>
          </div>

        </div>
      </div>

      <div class="architecture-connector">
        <span>Data Access · Parameterized SQL Queries</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- PostgreSQL stores application, authentication, and session data -->
      <div class="architecture-node">
        <span class="architecture-label">DATABASE</span>
        <h3>PostgreSQL</h3>
        <p>Messages · Users · Session Store</p>
      </div>

    </div>
  </div>
</section>

<!-- ==================== CLOUD DEPLOYMENT ==================== -->
<!-- Shows how the production application and database are connected on Railway (Deployment Architecture) -->

<section id="deployment" class="section-padding">
  <div class="container">

    <div class="text-center mb-5">
      <p class="section-label">CLOUD DEPLOYMENT</p>

      <h2 class="section-title">Deployment Architecture</h2>

      <p class="about-text mt-3">
        The production application is deployed as a Railway service and connects
        to Railway PostgreSQL through the private network. Public application
        traffic uses HTTPS, while application data and session storage are
        persisted in PostgreSQL.
      </p>
    </div>

    <div class="architecture-diagram">

      <!-- Public user accesses the deployed application -->
      <div class="architecture-node">
        <span class="architecture-label">CLIENT</span>
        <h3>Public User / Browser</h3>
        <p>Portfolio · Authentication</p>
      </div>

      <div class="architecture-connector">
        <span>HTTPS</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Railway exposes the deployed application through its public domain -->
      <div class="architecture-node">
        <span class="architecture-label">PUBLIC ACCESS</span>
        <h3>Railway Public Domain</h3>
        <p>Public Application Endpoint</p>
      </div>

      <div class="architecture-connector">
        <span>HTTPS Request</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Application components running inside the Railway service -->
      <div class="architecture-application-layer">
        <span class="architecture-label">APPLICATION SERVICE</span>

        <div class="architecture-layer-content">

          <div>
            <h3>Node.js / Express</h3>
            <p>EJS Portfolio · React Auth Build</p>
          </div>

          <div>
            <h3>Backend Services</h3>
            <p>REST APIs · Sessions · Authentication · RBAC</p>
          </div>

        </div>
      </div>

      <div class="architecture-connector">
        <span>Private Database Connection · DATABASE_URL</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Railway service communicates with PostgreSQL through private networking -->
      <div class="architecture-node">
        <span class="architecture-label">PRIVATE CONNECTIVITY</span>
        <h3>Railway Private Network</h3>
        <p>Application-to-Database Traffic</p>
      </div>

      <div class="architecture-connector">
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Production PostgreSQL stores application, authentication, and session data -->
      <div class="architecture-node">
        <span class="architecture-label">DATABASE</span>
        <h3>Railway PostgreSQL</h3>
        <p>Messages · Users · Session Store</p>
      </div>

    </div>
  </div>
</section>

