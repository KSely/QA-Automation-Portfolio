<!-- ==================== PROJECT OVERVIEW ==================== -->
<!-- Introduces the application, its purpose, and main project goals (Project Overview) -->
<section id="overview" class="project-hero section-padding">
  <div class="container">
    <p class="section-label">QA AUTOMATION PROJECT</p>

    <h1 class="display-5 fw-bold mb-4">Full-Stack QA Automation Project</h1>

    <p class="lead">
      Web Application · Unit Testing · UI Automation · API Testing · Database Validation
    </p>

    <hr class="my-5" />

    <div class="row g-5">

      <!-- Describe the application and what it was built for (Application Under Test) -->
      <div class="col-lg-7">
        <p class="section-label">PROJECT OVERVIEW</p>

        <h2 class="section-title mb-4">Application Under Test</h2>

        <p class="about-text">
          This project is a full-stack web application developed as an
          Application Under Test (AUT) for demonstrating practical software
          testing and QA automation.
        </p>

        <p class="about-text">
          The application includes a responsive user interface, server-side
          processing, HTTP endpoints, form validation, and PostgreSQL database
          integration.
        </p>

        <p class="about-text">
          The project is designed to demonstrate testing across multiple
          application layers, including UI, API, backend, and database
          validation.
        </p>
      </div>

      <!-- Describe the main goals of the project (Project Goals) -->
      <div class="col-lg-5">
        <div class="skill-card project-goals-card">
          <h3>Project Goals</h3>

          <p>
            Build and test a realistic full-stack application using professional
            QA practices and automation tools.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ==================== APPLICATION ARCHITECTURE ==================== -->
<!-- Shows how the main parts of the application work together (Application Architecture) -->
<section id="architecture" class="skills-section section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">SYSTEM DESIGN</p>

      <h2 class="section-title">Application Architecture</h2>

      <p class="about-text mt-3">
        The application follows a layered full-stack architecture connecting the
        client interface, server-side application logic, data access, and
        PostgreSQL database.
      </p>
    </div>

    <!-- Show how requests and data move through the application (Architecture Diagram) -->
    <div class="architecture-diagram">

      <!-- User accesses the application through a web browser (Client Layer) -->
      <div class="architecture-node">
        <span class="architecture-label">CLIENT</span>
        <h3>User / Browser</h3>
      </div>

      <div class="architecture-connector">
        <span>HTTP / HTTPS</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- User interface displayed in the browser (Frontend Layer) -->
      <div class="architecture-node">
        <span class="architecture-label">FRONTEND</span>
        <h3>Web Application UI</h3>
        <p>HTML · CSS · Bootstrap · EJS · JavaScript</p>
      </div>

      <div class="architecture-connector">
        <span>HTTP Requests / Fetch</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Backend server receives and processes application requests (Application Server) -->
      <div class="architecture-node">
        <span class="architecture-label">APPLICATION SERVER</span>
        <h3>Node.js / Express.js</h3>
      </div>

      <div class="architecture-connector">
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Handles routes, validation, requests, and responses (Application Layer) -->
      <div class="architecture-application-layer">
        <span class="architecture-label">APPLICATION LAYER</span>

        <div class="architecture-layer-content">
          <div>
            <h3>Routing</h3>
            <p>Page Routes · API Endpoints · Form Requests</p>
          </div>

          <div>
            <h3>Request Processing</h3>
            <p>Validation · Processing · Response Handling</p>
          </div>
        </div>
      </div>

      <div class="architecture-connector">
        <span>Data Access / Parameterized Queries</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <!-- Stores application data in PostgreSQL (Database Layer) -->
      <div class="architecture-node">
        <span class="architecture-label">DATABASE</span>
        <h3>PostgreSQL</h3>
        <p>Application Data · Persistent Storage</p>
      </div>
    </div>
  </div>
</section>


<!-- ==================== CLOUD DEPLOYMENT ==================== -->
<!-- Shows how the production application and database are connected on Railway (Deployment Architecture) -->
<section id="deployment" class="section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">CLOUD DEPLOYMENT</p>

      <h2 class="section-title">Deployment Architecture</h2>

      <p class="about-text mt-3">
        The production application is deployed on Railway and uses a private
        connection to Railway PostgreSQL.
      </p>
    </div>

    <div class="architecture-diagram">
      <div class="architecture-node">
        <span class="architecture-label">CLIENT</span>
        <h3>Public User / Browser</h3>
      </div>

      <div class="architecture-connector">
        <span>HTTPS</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <div class="architecture-node">
        <span class="architecture-label">PUBLIC ACCESS</span>
        <h3>Railway Public Domain</h3>
      </div>

      <div class="architecture-connector">
        <div class="architecture-arrow">↓</div>
      </div>

      <div class="architecture-node">
        <span class="architecture-label">APPLICATION SERVICE</span>
        <h3>Node.js / Express Service</h3>
      </div>

      <div class="architecture-connector">
        <span>DATABASE_URL</span>
        <div class="architecture-arrow">↓</div>
      </div>

      <div class="architecture-node">
        <span class="architecture-label">PRIVATE CONNECTIVITY</span>
        <h3>Railway Private Network</h3>
      </div>

      <div class="architecture-connector">
        <div class="architecture-arrow">↓</div>
      </div>

      <div class="architecture-node">
        <span class="architecture-label">DATABASE</span>
        <h3>Railway PostgreSQL</h3>
      </div>
    </div>
  </div>
</section>


