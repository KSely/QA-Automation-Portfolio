<!-- Test Strategy & Coverage -->
<section id="test-strategy" class="section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">TEST STRATEGY</p>

      <h2 class="section-title">Test Strategy & Coverage</h2>

      <p class="about-text mt-3">
        Multi-layer testing strategy designed to validate functionality,
        integration, data integrity, reliability, and application behavior
        across the full system.
      </p>
    </div>

    <div class="row g-4">
      <!-- UI Testing -->
      <div class="col-md-6">
        <div class="test-strategy-card">
          <span class="testing-category">UI LAYER</span>
          <h3>Functional & UI Testing</h3>

          <ul>
            <li>Page navigation and user workflows</li>
            <li>Contact form submission</li>
            <li>Client-side validation</li>
            <li>Positive and negative scenarios</li>
            <li>Cross-browser behavior</li>
          </ul>
        </div>
      </div>

      <!-- API Testing -->
      <div class="col-md-6">
        <div class="test-strategy-card">
          <span class="testing-category">API LAYER</span>
          <h3>API & HTTP Validation</h3>

          <ul>
            <li>API endpoint validation</li>
            <li>HTTP methods and requests</li>
            <li>Response status codes</li>
            <li>Response body validation</li>
            <li>Error and invalid-request handling</li>
          </ul>
        </div>
      </div>

      <!-- Backend & Database -->
      <div class="col-md-6">
        <div class="test-strategy-card">
          <span class="testing-category">DATA LAYER</span>
          <h3>Backend & Database Validation</h3>

          <ul>
            <li>Server-side input validation</li>
            <li>Database record creation</li>
            <li>Stored data accuracy</li>
            <li>Data integrity verification</li>
            <li>UI/API-to-database consistency</li>
          </ul>
        </div>
      </div>

      <!-- Performance -->
      <div class="col-md-6">
        <div class="test-strategy-card">
          <span class="testing-category">PERFORMANCE LAYER</span>
          <h3>Performance & Reliability</h3>

          <ul>
            <li>Response time measurement</li>
            <li>Load testing</li>
            <li>Stress testing</li>
            <li>Endurance testing</li>
            <li>Application stability under load</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- API Coverage -->
<section id="api-testing" class="skills-section section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">API VALIDATION</p>

      <h2 class="section-title">API Coverage & Endpoints</h2>

      <p class="about-text mt-3">
        HTTP endpoints are validated for request handling, response content,
        status codes, input validation, and error scenarios.
      </p>
    </div>

    <div class="row g-4">
      <!-- Status Endpoint -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method get-method">GET</span>

          <h3>/api/status</h3>

          <p>
            Verifies that the application backend is running and responding
            correctly.
          </p>

          <ul>
            <li>Expected status: 200 OK</li>
            <li>JSON response validation</li>
            <li>Backend availability check</li>
          </ul>
        </div>
      </div>

      <!-- Contact Endpoint -->
      <div class="col-md-6">
        <div class="api-endpoint-card">
          <span class="api-method post-method">POST</span>

          <h3>/contact</h3>

          <p>
            Processes contact form submissions and stores validated data in
            PostgreSQL.
          </p>

          <ul>
            <li>Valid submission: 200 OK</li>
            <li>Missing fields: 400 Bad Request</li>
            <li>Invalid email: 400 Bad Request</li>
            <li>Response body validation</li>
            <li>Database persistence validation</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Database Validation -->
<section id="database-testing" class="section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">DATABASE VALIDATION</p>

      <h2 class="section-title">Database Testing</h2>

      <p class="about-text mt-3">
        Contact form data is validated across the application flow from request
        processing through persistent storage in PostgreSQL.
      </p>
    </div>

    <div class="row g-4">
      <!-- Database Schema -->
      <div class="col-lg-6">
        <div class="database-validation-card">
          <span class="database-category">DATABASE SCHEMA</span>

          <h3>messages</h3>

          <div class="database-field">
            <span>id</span>
            <span>SERIAL PRIMARY KEY</span>
          </div>

          <div class="database-field">
            <span>name</span>
            <span>VARCHAR(255)</span>
          </div>

          <div class="database-field">
            <span>email</span>
            <span>VARCHAR(255)</span>
          </div>

          <div class="database-field">
            <span>message</span>
            <span>TEXT</span>
          </div>

          <div class="database-field">
            <span>created_at</span>
            <span>TIMESTAMP</span>
          </div>
        </div>
      </div>

      <!-- Data Validation -->
      <div class="col-lg-6">
        <div class="database-validation-card">
          <span class="database-category">DATA VALIDATION</span>

          <h3>UI → API → Database</h3>

          <ul class="database-validation-list">
            <li>Contact form data submission</li>
            <li>Server-side input validation</li>
            <li>Database record creation</li>
            <li>Name, email, and message verification</li>
            <li>Stored data accuracy</li>
            <li>Timestamp verification</li>
            <li>UI/API-to-database consistency</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
