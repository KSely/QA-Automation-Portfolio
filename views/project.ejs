<!-- ==================== QA & TESTING STACK ==================== -->
<!-- Shows the tools and frameworks used to test different parts of the application (Testing Stack) -->
<section id="qa-stack" class="skills-section section-padding">
  <div class="container">
    <div class="text-center mb-5">
      <p class="section-label">QUALITY ENGINEERING</p>

      <h2 class="section-title">QA & Testing Stack</h2>

      <p class="about-text mt-3">
