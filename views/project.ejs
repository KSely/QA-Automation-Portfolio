        quality across unit, UI, API, database, accessibility, performance, and
        cross-browser layers.
      </p>
    </div>

    <!-- Main testing tools grouped by testing area (QA Toolset) -->
    <div class="row g-4">

      <!-- Jest validates application-owned server-side logic without external dependencies (Unit Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">UNIT TESTING</span>
          <h3>Jest</h3>
          <p>15 Tests · Contact Validation · GitHub Actions</p>
        </div>
      </div>

      <!-- Selenium framework for browser-based automated testing (UI Automation) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">UI AUTOMATION</span>
          <h3>Selenium WebDriver</h3>
          <p>Java · TestNG · Maven</p>
        </div>
      </div>

      <!-- Playwright framework for browser-based automated testing (UI Automation) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">UI AUTOMATION</span>
          <h3>Playwright</h3>
          <p>JavaScript</p>
        </div>
      </div>

      <!-- Playwright and axe-core validate selected rendered accessibility conditions (Accessibility Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">ACCESSIBILITY TESTING</span>
          <h3>Playwright + axe-core</h3>
          <p>
            WCAG-Oriented Scans · Color Contrast · Accessible Names · Required
            Semantics · Focus and Enter Activation
          </p>
        </div>
      </div>

      <!-- Validates HTTP requests and responses through automated and manual API tools (API Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">API TESTING</span>
          <h3>REST Assured · Playwright API · Postman</h3>
          <p>HTTP Requests · Status Codes · Response Validation</p>
        </div>
      </div>

      <!-- Verifies stored data and database behavior using SQL (Database Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">DATABASE TESTING</span>
          <h3>PostgreSQL</h3>
          <p>SQL · Data Integrity · Backend Validation</p>
        </div>
      </div>

      <!-- Measures application behavior under different levels of load (Performance Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">PERFORMANCE TESTING</span>
          <h3>Apache JMeter</h3>
          <p>Smoke · Baseline · Load · Stress</p>
        </div>
      </div>

      <!-- Checks application behavior across supported browsers (Cross-Browser Testing) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">CROSS-BROWSER TESTING</span>
          <h3>Browser Coverage</h3>
          <p>Chrome · Firefox · Edge</p>
        </div>
      </div>

      <!-- Covers different test levels and test scenarios (Test Design) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">TEST DESIGN</span>
          <h3>Test Coverage</h3>
          <p>Smoke · Regression · Positive · Negative</p>
        </div>
      </div>

      <!-- Provides results from automated test execution (Test Reporting) -->
      <div class="col-md-6 col-lg-4">
        <div class="testing-stack-card">
          <span class="testing-category">TEST REPORTING</span>
          <h3>Automation Results</h3>
          <p>Allure · TestNG · Playwright HTML Reports</p>
